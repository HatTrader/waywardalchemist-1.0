{
  "multipart": [
    {
      "apply": {
        "model": "waywardalchemist:block/boiling_brewer_block"
      }
    },
    {
      "apply": {
        "model": "waywardalchemist:block/boiling_brewer_bottle0"
      },
      "when": {
        "has_bottle_0": "true"
      }
    },
    {
      "apply": {
        "model": "waywardalchemist:block/boiling_brewer_bottle1"
      },
      "when": {
        "has_bottle_1": "true"
      }
    },
    {
      "apply": {
        "model": "waywardalchemist:block/boiling_brewer_bottle2"
      },
      "when": {
        "has_bottle_2": "true"
      }
    },
    {
      "apply": {
        "model": "waywardalchemist:block/boiling_brewer_empty0"
      },
      "when": {
        "has_bottle_0": "false"
      }
    },
    {
      "apply": {
        "model": "waywardalchemist:block/boiling_brewer_empty1"
      },
      "when": {
        "has_bottle_1": "false"
      }
    },
    {
      "apply": {
        "model": "waywardalchemist:block/boiling_brewer_empty2"
      },
      "when": {
        "has_bottle_2": "false"
      }
    }
  ]
}